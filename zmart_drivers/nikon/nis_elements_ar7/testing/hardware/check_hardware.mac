WaitText(1, "ZMART hardware check - running. Leave NIS alone until it says finished.");
Python_RunString("import os, glob, runpy; h = os.path.expanduser('~'); n = 'zmart_drivers/nikon/nis_elements_ar7/testing/hardware/check_hardware_nis.py'; c = ['C:/ZMART-drivers/' + n] + sorted(glob.glob(h + '/Desktop/*/' + n)) + sorted(glob.glob(h + '/OneDrive*/Desktop/*/' + n)) + sorted(glob.glob(h + '/Documents/*/' + n)); f = next((p for p in c if os.path.isfile(p)), None); runpy.run_path(f, run_name='__main__') if f else open(h + '/Desktop/zmart_check_NOT_FOUND.txt', 'w').write('check_hardware_nis.py was not found; put the ZMART-drivers folder at C:/ZMART-drivers or on the Desktop. Looked in: ' + repr(c))");
WaitText(2, "ZMART hardware check - finished. The results folder is beside check_hardware_nis.py.");
